---
import { site } from "@/config/site";
import { withBase } from "@/lib/base";
import Icon from "@/components/Icon.astro";
import SiteMark from "@/components/SiteMark.astro";
// import Dot from "@/components/Dot.astro";

const year = new Date().getFullYear();
---

{/* The background image dissolves into the page above the footer-fade,
    a scrim keeps the light text legible over the waves in either theme */}
<footer class="relative isolate mt-24 overflow-hidden text-white">
  <div class="footer-fade absolute inset-2 -z-10" aria-hidden="true">
    <img
      src={withBase("/graphics/hero-graphic.svg")}
      alt=""
      class="size-full object-cover object-[center_60%]"
      width="1600"
      height="1000"
      loading="lazy"
    />
    {/* for legibility so the gradient deepens toward the bottom */}
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--water-abyss)]/40 via-[var(--water-abyss)]/58 to-[var(--water-abyss)]/88"></div>
  </div>

  <div class="grid w-full gap-8 px-4 pb-14 pt-44 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr] lg:px-10">
    <div class="max-w-sm">
      <div class="flex items-center gap-2.5 font-display text-lg font-semibold">
        <SiteMark
          monogramClass="bg-cavern font-display text-sm font-bold text-white"
          faviconClass="rounded-md bg-white/5 p-0.5 ring-2 ring-white/50 shadow-lg backdrop-blur-[2px]"
        />
        {site.name}
      </div>
      <p class="mt-3 text-sm leading-relaxed text-white/65">{site.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-white/55">Explore</h2>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        {site.nav.map((item) => (
          <li>
            <a class="text-white/80 transition-colors hover:text-cavern-glow" href={withBase(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-white/55">Connect</h2>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        <li>
          <a class="inline-flex items-center gap-1.5 text-white/80 transition-colors hover:text-cavern-glow" href={site.socials.github} rel="noopener noreferrer" target="_blank">
            <Icon name="github" class="size-4" />
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="flex w-full flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-white/55 sm:flex-row sm:px-6 lg:px-10">
      <p>Built by {site.fullName}, {year}</p>
        <p class="flex items-center gap-2 font-mono">
            <!--<span></span>-->
            <!--<Dot />-->
            <!--<span></span>-->
        </p>
    </div>
  </div>
</footer>
