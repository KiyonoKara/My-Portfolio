---
import { site } from "@/config/site";
import { withBase } from "@/lib/base";
import ThemeToggle from "@/components/ThemeToggle.astro";
import SiteMark from "@/components/SiteMark.astro";

const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, "");
  return path === target || (href !== "/" && path.startsWith(target));
};
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-background/80 backdrop-blur-md">
  <nav class="flex h-16 w-full items-center justify-between gap-4 px-4 sm:px-6 lg:px-10" aria-label="Primary">
    <a
      href={withBase("/")}
      class="group flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight"
    >
      <SiteMark
        monogramClass="bg-cavern font-display text-sm font-bold text-primary-foreground shadow-sm"
        class="transition-transform group-hover:-rotate-6"
      />
      <span>{site.name}</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="mr-1 hidden items-center gap-1 sm:flex">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-secondary",
                  isActive(item.href) ? "text-cavern" : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-md border border-border text-foreground sm:hidden hover:bg-secondary transition-colors focus-visible:ring-offset-background cursor-pointer"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-open="false"
    inert
    class="group grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out data-[open=true]:grid-rows-[1fr] sm:hidden"
  >
    <div class="overflow-hidden">
      <ul class="flex flex-col gap-1 border-t border-border/70 px-4 py-3 opacity-0 transition-opacity duration-300 group-data-[open=true]:opacity-100">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class="block rounded-md px-3 py-2.5 text-sm font-medium text-foreground hover:bg-secondary"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    const isOpen = () => menu.dataset.open === "true";
    const setOpen = (open) => {
      menu.dataset.open = open ? "true" : "false";
      // this keeps the hidden links out of the tab order and the a11y tree
      menu.inert = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    btn.addEventListener("click", () => setOpen(!isOpen()));

    // Close on Escape, on a link click, or when tapping outside the menu
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) setOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (!isOpen()) return;
      if (menu.contains(e.target) || btn.contains(e.target)) return;
      setOpen(false);
    });
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false))
    );
  })();
</script>
