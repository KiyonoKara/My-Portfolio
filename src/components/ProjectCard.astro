---
import type { Project } from "@/lib/content";
import { accentMap, projectRepoUrl, kindLabel } from "@/lib/content";
import { withBase } from "@/lib/base";
import { Badge } from "@/components/ui/badge";
import ResponsiveImage from "@/components/ResponsiveImage.astro";

interface Props {
  project: Project;
  // larger treatment for the featured bento hero tile
  feature?: boolean;
  class?: string;
}
const { project, feature = false, class: className } = Astro.props;
const { data, id } = project;
const a = accentMap[data.accent];
const href = withBase(`/work/${id}`);
const cover = data.cover ?? null;
const repoUrl = projectRepoUrl(data);
const isTerminal = data.variant === "terminal";
const dateLabel = data.period ?? String(data.year);
---

<div
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-[16px_14px_15px_13px] border bg-card shadow-sm transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-xl hover:ring-1 hover:ring-cavern/15",
    a.border,
    isTerminal && "font-mono",
    className,
  ]}
>
  {/* stretched link that points to the project page and sits above content below the repo button */}
  <a href={href} class="absolute inset-0 z-10" aria-label={`View the ${data.title} project`}></a>

  {/* repo button above the stretched link */}
  {
    repoUrl && (
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute right-3 top-3 z-20 inline-flex size-8 items-center justify-center rounded-full bg-background/85 text-foreground shadow backdrop-blur transition-all hover:-translate-y-0.5 hover:text-cavern hover:shadow-md"
        aria-label={`${data.title}, view source on GitHub`}
        title="View source"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.19 1.82 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.14c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
        </svg>
      </a>
    )
  }

  {/* cover over a skeleton base. Shows the skeleton if the cover is unset or 404s */}
  <div class:list={["relative overflow-hidden", feature ? "aspect-[16/10]" : "aspect-[4/3]", a.softBg]}>
    <div class="skeleton-shimmer absolute inset-0" aria-hidden="true">
      {/* skeleton content bars */}
      <div class="absolute inset-x-4 bottom-4 flex flex-col gap-2">
        <span class="h-2.5 w-2/5 rounded-full bg-foreground/[0.09]" />
        <span class="h-2 w-3/5 rounded-full bg-foreground/[0.07]" />
      </div>
    </div>
    {cover && (
      <ResponsiveImage
        path={cover}
        alt=""
        sizes="(min-width: 1280px) 24vw, (min-width: 768px) 33vw, 90vw"
        class="absolute inset-0"
        imgClass="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        onerror="this.style.display='none'"
      />
    )}
    <div class:list={["pointer-events-none absolute inset-0", a.gradient]} />
    {/* top-left cluster where date sits to the left of the Live Demo pill */}
    <div class="pointer-events-none absolute left-3 top-3 flex items-center gap-1.5">
      <span class="rounded-full bg-black/45 px-2.5 py-1 font-mono text-[11px] font-medium tracking-wide text-white/90 shadow-sm ring-1 ring-white/10 backdrop-blur-sm">
        {dateLabel}
      </span>
      {data.demo && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-background/85 px-2.5 py-1 text-xs font-semibold text-cavern shadow-sm ring-1 ring-cavern/15 backdrop-blur">
          <span class="relative flex size-1.5">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-cavern opacity-75 motion-reduce:hidden" />
            <span class="relative inline-flex size-1.5 rounded-full bg-cavern" />
          </span>
          Live Demo
        </span>
      )}
    </div>
  </div>

  {/* body */}
  <div class="flex flex-1 flex-col gap-2.5 p-5">
    <div class="flex items-start justify-between gap-2">
      {data.tagline && (
        <p class:list={["text-xs font-semibold uppercase tracking-wider", a.text]}>{data.tagline}</p>
      )}
      {data.kind.length > 0 && (
        <div class="flex shrink-0 flex-wrap justify-end gap-1">
          {data.kind.map((k) => (
            <span class:list={["rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider", a.border, a.text]}>
              {kindLabel[k] ?? k}
            </span>
          ))}
        </div>
      )}
    </div>

    <h3 class:list={["font-semibold leading-tight tracking-tight", isTerminal ? "font-mono" : "font-display", feature ? "text-2xl" : "text-xl"]}>
      {data.title}
    </h3>

    <p class="line-clamp-3 text-sm leading-relaxed text-muted-foreground">{data.short_description}</p>

    <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
      {data.stack.slice(0, feature ? 6 : 4).map((s) => (
        <Badge variant="tag" className="font-mono text-[10px]">{s}</Badge>
      ))}
    </div>
  </div>
</div>
