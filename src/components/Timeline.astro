---
import type { Experience } from "@/lib/content";
import { Badge } from "@/components/ui/badge";
import Dot from "@/components/Dot.astro";

interface Props {
  items: Experience[];
}
const { items } = Astro.props;

const typeLabel: Record<string, string> = {
  work: "Full-time",
  coop: "Co-op",
  internship: "Internship",
  club: "Club",
  freelance: "Freelance",
  part_time: "Part-time",
  contract: "Contract",
};
---

<ol class="relative">
  {
    items.map((exp) => (
      <li class="reveal relative grid gap-4 border-l border-border pb-10 pl-6 last:pb-0 sm:grid-cols-[10rem_1fr] sm:gap-8 sm:pl-8">
        <span class="absolute -left-[6.5px] top-1.5 size-3 rounded-full border-2 border-background bg-cavern" aria-hidden="true" />
        <div class="sm:pt-0.5">
          <p class="font-mono text-xs text-muted-foreground">{exp.data.period}</p>
          <p class="mt-1 text-[11px] font-medium uppercase tracking-wider text-cavern">
            {typeLabel[exp.data.type] ?? exp.data.type}
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold leading-tight">{exp.data.role}</h3>
          <p class="flex flex-wrap items-center gap-1.5 text-sm font-medium text-foreground/80">
            <span>{exp.data.org}</span>
            {exp.data.location && <Dot class="text-muted-foreground" />}
            {exp.data.location && <span class="text-muted-foreground">{exp.data.location}</span>}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{exp.data.description}</p>
          {exp.data.bullets.length > 0 && (
            <ul class="mt-3 flex flex-col gap-2">
              {exp.data.bullets.map((b) => (
                <li class="relative pl-5 text-sm leading-relaxed text-foreground/85">
                  <span class="absolute left-0 top-2 size-1.5 rotate-45 rounded-[1px] bg-cavern/70" aria-hidden="true" />
                  {b}
                </li>
              ))}
            </ul>
          )}
          {exp.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {exp.data.tags.map((t) => (
                <Badge variant="outline" className="font-mono text-[10px]">{t}</Badge>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>
