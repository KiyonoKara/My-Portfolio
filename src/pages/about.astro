---
import Base from "@/layouts/Base.astro";
import Section from "@/components/Section.astro";
import Timeline from "@/components/Timeline.astro";
import { Badge } from "@/components/ui/badge";
import Dot from "@/components/Dot.astro";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import { getFeaturedExperiences, getAdditionalExperiences } from "@/lib/content";
import { bio, education, certifications, skills, studyAbroad } from "@/config/about";
import { site } from "@/config/site";
import { withBase } from "@/lib/base";

const featuredExp = await getFeaturedExperiences();
const additionalExp = await getAdditionalExperiences();
---

<Base title="About" description={site.description}>
  <div class="seigaiha">
  {/* intro */}
  <section class="mx-auto grid max-w-7xl gap-12 px-6 lg:px-10 pb-12 pt-16 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="reveal mb-3 font-display text-sm italic tracking-[0.01em] text-cavern">About</p>
      <h1 class="reveal font-display text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
        {site.name}{site.role.trim().toLowerCase() ? `, ${site.role}` : ""}
      </h1>
      <div class="reveal mt-6 flex max-w-xl flex-col gap-4 text-base leading-relaxed text-muted-foreground [transition-delay:100ms]">
        {bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="reveal [transition-delay:120ms]">
      <ResponsiveImage
        path="/photos/my_portrait.jpeg"
        alt="Portrait"
        sizes="(min-width: 1024px) 38vw, 90vw"
        loading="eager"
        class="block"
        imgClass="aspect-[4/5] w-full rotate-[-0.6deg] rounded-2xl border border-border object-cover shadow-lg transition-transform hover:rotate-0"
      />
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-6 lg:px-10"><hr class="ink-rule" /></div>

  {/* education */}
  <Section label="Education" title="University">
    <div class="reveal mt-8 rounded-2xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="font-display text-2xl font-semibold">{education.school}</h3>
        <span class="font-mono text-xs text-muted-foreground">{education.period}</span>
      </div>
      <p class="mt-1 text-sm font-medium text-cavern">{education.college}</p>
      <p class="mt-3 text-foreground/85">{education.degree}</p>
      <p class="mt-1 text-sm text-foreground/70">
        Concentration in {education.concentration}. Minor in {education.minor}.
      </p>
      <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <span>GPA {education.gpa}</span>
        <Dot />
        <span>{education.honors}</span>
        <Dot />
        <span>{education.location}</span>
      </p>
      <div class="mt-5">
        <p class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground">Relevant coursework</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {education.coursework.map((c) => <Badge variant="tag" className="text-[11px]">{c}</Badge>)}
        </div>
      </div>
    </div>
  </Section>

  {/* Certifications */}
  <Section label="Certifications" title="Certifications" class="pt-0">
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        certifications.map((c) => (
          <div class="reveal rounded-2xl border border-border bg-card p-5 shadow-sm">
            <p class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground">{c.date}</p>
            <h3 class="mt-1 font-display text-lg font-semibold leading-snug">{c.name}</h3>
            <p class="mt-2 text-sm text-foreground/85">{c.detail}</p>
            <p class="mt-0.5 text-sm text-muted-foreground">{c.issuer}</p>
          </div>
        ))
      }
    </div>
  </Section>

  {/* study abroad */}
  <Section
    label="Study abroad"
    title="Time spent abroad"
    description="A term in London and two programs in Japan. Open a gallery to see a few photos from each."
    class="pt-0"
  >
    <div class="mt-8 flex flex-col gap-5">
      {
        studyAbroad.map((a) => (
          <article class="reveal rounded-2xl border border-border bg-card p-6 shadow-sm">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-xl font-semibold">{a.school}</h3>
              <span class="font-mono text-xs text-muted-foreground">{a.period}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-cavern">{a.program}</p>
            <p class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground">{a.location}</p>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-foreground/85">{a.description}</p>

            {a.photos.length > 0 && (
              <details class="group mt-4">
                <summary class="inline-flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-border px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:border-cavern/40 hover:text-cavern [&::-webkit-details-marker]:hidden">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  See a few photos ({a.photos.length})
                  <svg class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                  {a.photos.map((p, i) => (
                    <figure class={`overflow-hidden rounded-xl border border-border bg-background/60 transition-transform hover:rotate-0 ${i % 2 ? "rotate-[0.7deg]" : "-rotate-[0.7deg]"}`}>
                      <ResponsiveImage
                        path={p.src}
                        alt={p.alt}
                        sizes="(min-width: 640px) 33vw, 80vw"
                        class="block"
                        imgClass="aspect-[4/3] w-full object-cover"
                      />
                      {p.caption && (
                        <figcaption class="px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-muted-foreground">{p.caption}</figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </details>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  {/* skills */}
  <Section label="Toolkit" title="Skills" class="pt-0">
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((s) => (
        <div class="reveal rounded-2xl border border-border bg-card p-5 shadow-sm">
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-cavern">{s.group}</h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {s.items.map((i) => <Badge variant="tag">{i}</Badge>)}
          </div>
        </div>
      ))}
    </div>
  </Section>

  {/* main experience */}
  <Section label="Experience" title="Where I've worked" class="pt-0">
    <div class="mt-10 max-w-3xl"><Timeline items={featuredExp} /></div>
  </Section>

  {additionalExp.length > 0 && (
    <Section label="Additional experience" title="Other roles" class="pt-0">
      <div class="mt-10 max-w-3xl"><Timeline items={additionalExp} /></div>
    </Section>
  )}
  </div>
</Base>
